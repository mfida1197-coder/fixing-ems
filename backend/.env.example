# Copy to .env and fill in real values. NEVER commit .env
PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_USER=ems_user
DB_PASSWORD=change_me
DB_NAME=ashtech_ems

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=put_long_random_string_here
JWT_EXPIRES_IN=8h

# AES-256 key for sensitive fields (64 hex chars). Generate:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=put_64_hex_chars_here

# Allowed frontend origin
CORS_ORIGIN=http://localhost:5173

# Gmail API OAuth Web application (backend only). Register this exact callback in Google Cloud.
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/email/oauth/callback